# Frontend: demo requires no API and works on Vercel. Never put secrets in VITE_*.
VITE_APP_MODE=demo
# For connected mode: VITE_APP_MODE=api and VITE_API_URL=/api (local proxy)
VITE_API_URL=/api
# Backend
PORT=4000
DATABASE_PATH=./data/quizforge.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
# Local development only; server refuses this flag in production.
ENABLE_DEMO_ACCOUNTS=true
ALLOW_REGISTRATION=true
# First admin for production: set both, then run npm run admin:create.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-unique-password
