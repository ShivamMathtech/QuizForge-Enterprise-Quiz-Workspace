{
  "name": "quizforge-enterprise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "node scripts/dev-full.mjs",
    "server:dev": "node --import tsx --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test server/tests/*.test.ts shared/*.test.ts",
    "check": "npm run build:all && npm test",
    "admin:create": "node --import tsx --env-file-if-exists=.env server/create-admin.ts",
    "db:backup": "node --import tsx --env-file-if-exists=.env server/backup.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.9.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
